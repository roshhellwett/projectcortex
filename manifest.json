{
  "manifest_version": 3,
  "name": "ProjectCortex",
  "version": "2.2.0",
  "description": "AI-powered productivity assistant. Summarize, fact-check, find correct MCQ answers, and ask anything about any page.",
  "author": "roshhellwett",
  "homepage_url": "https://github.com/roshhellwett/projectcortex",
  "icons": {
    "16": "icons/logo16.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "bg_main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_globals.js",
        "content_utils.js",
        "content_anti_cheat.js",
        "content_ui.js",
        "content_ai.js",
        "content_main.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProjectCortex",
    "default_icon": {
      "16": "icons/logo16.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    }
  }
}