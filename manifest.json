{
  "manifest_version": 3,
  "name": "ProjectCortex — Intelligence",
  "version": "9.0.0",
  "description": "Unlock premium intelligence directly inside your browser. Ask, summarize, and analyze anything instantly.",
  "author": "roshhellwett",
  "homepage_url": "https://github.com/roshhellwett/projectcortex",
  "icons": {
    "16": "icons/logo16.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "commands": {
    "open_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open ProjectCortex Panel"
    }
  },
  "background": {
    "service_worker": "bg_main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_globals.js",
        "content_utils.js",
        "content_anti_cheat.js",
        "content_ui.js",
        "content_ai.js",
        "content_main.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProjectCortex",
    "default_icon": {
      "16": "icons/logo16.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    }
  }
}